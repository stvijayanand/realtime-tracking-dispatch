# =============================================================================
# Real-Time Ride/Delivery Tracking Platform — Root .gitignore
# Monorepo covering: Python (FastAPI), Java (Spring Boot), Node (React/Next.js),
# Terraform, Helm, Kubernetes, Docker, and CI/CD tooling.
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets & credentials — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/
credentials.json
service-account*.json
aws-credentials
.aws/
.kube/config
kubeconfig
*.kubeconfig


# -----------------------------------------------------------------------------
# Python (FastAPI services: ingestion gateway, ETA streaming, notifications)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.whl
.installed.cfg

# Virtual environments
venv/
.venv/
env/
ENV/
.python-version

# Package managers
pip-log.txt
pip-delete-this-directory.txt
poetry.lock.backup
.pdm.toml
__pypackages__/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Jupyter (in case you sketch anything)
.ipynb_checkpoints/


# -----------------------------------------------------------------------------
# Java (Spring Boot: dispatch, trip state; Flink jobs)
# -----------------------------------------------------------------------------
# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
gradle-app.setting
.gradletasknamecache

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Compiled
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Spring Boot
spring-boot-*.log


# -----------------------------------------------------------------------------
# Node.js / Frontend (rider app, driver simulator)
# -----------------------------------------------------------------------------
node_modules/
.pnp.*
.yarn/cache
.yarn/install-state.gz
.yarn/build-state
.yarn/unplugged

# Build outputs
.next/
out/
.nuxt/
.svelte-kit/
.turbo/
.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Testing
/coverage
.nyc_output


# -----------------------------------------------------------------------------
# Infrastructure: Terraform / OpenTofu
# -----------------------------------------------------------------------------
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc


# -----------------------------------------------------------------------------
# Kubernetes / Helm / ArgoCD
# -----------------------------------------------------------------------------
# Helm
charts/*.tgz
**/charts/*.tgz
.helm/

# Don't commit rendered manifests (keep templates only)
**/manifests-rendered/

# Skaffold cache
.skaffold/


# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
.dockerignore.local
docker-compose.override.yml
docker-compose.local.yml


# -----------------------------------------------------------------------------
# Observability / load testing local data
# -----------------------------------------------------------------------------
# Don't commit local Grafana/Prometheus/Tempo/Loki data dirs
grafana-data/
prometheus-data/
tempo-data/
loki-data/

# k6 / Locust output
k6-results/
locust-results/
*.k6.html
*.k6.json

# OpenTelemetry collector local config (if env-specific)
otel-collector-local.yaml


# -----------------------------------------------------------------------------
# IDEs & editors
# -----------------------------------------------------------------------------
# IntelliJ IDEA / PyCharm / WebStorm
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code (commit shared settings via .vscode-shared/ if desired)
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example
!.vscode/extensions.json
*.code-workspace
.history/

# Eclipse
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# Vim / Emacs
*.swp
*.swo
*~
.\#*
\#*\#
.dir-locals.el


# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/


