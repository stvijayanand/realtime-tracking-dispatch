# =============================================================================
# Real-Time Tracking & Dispatch Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running docker-compose.
# NEVER commit .env to source control — it is gitignored.
# All values below are placeholders. Replace "changeme" with strong passwords.
# See docs/adr/004-security-model.md for the full secrets management strategy.
#
# Stack: Go 1.22 (ingest, notification, gateway, tracking), Java 21/Spring Boot
# 3.x (dispatch), Apache Kafka 3-broker KRaft cluster (confluentinc/cp-kafka:7.6.1),
# Confluent Schema Registry, PgBouncer → PostgreSQL 16, Redis 7.2,
# DynamoDB Local, OpenTelemetry → Jaeger + Prometheus + Grafana.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (postgres:16-alpine)
# Used by the Dispatch Service via PgBouncer (transaction pooling mode).
# POSTGRES_* vars are consumed by the postgres container itself.
# SPRING_DATASOURCE_* vars are consumed by the Dispatch Service (Spring Boot).
# -----------------------------------------------------------------------------
POSTGRES_USER=dispatch_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dispatch_db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Kafka (Apache Kafka 3-broker KRaft cluster via confluentinc/cp-kafka:7.6.1)
# KAFKA_BOOTSTRAP_SERVERS is the broker list used by all application services.
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# -----------------------------------------------------------------------------
# Schema Registry (Confluent Schema Registry — enforces Avro schema compatibility)
# All Domain Event producers register schemas here on first publish.
# -----------------------------------------------------------------------------
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# -----------------------------------------------------------------------------
# Kafka SASL credentials — one set per service (principle of least privilege)
# Each service can only produce/consume the topics it owns (see ADR 004).
# -----------------------------------------------------------------------------
KAFKA_INGEST_USERNAME=ingest-service
KAFKA_INGEST_PASSWORD=changeme

KAFKA_DISPATCH_USERNAME=dispatch-service
KAFKA_DISPATCH_PASSWORD=changeme

KAFKA_NOTIFICATION_USERNAME=notification-service
KAFKA_NOTIFICATION_PASSWORD=changeme

KAFKA_TRACKING_USERNAME=tracking-service
KAFKA_TRACKING_PASSWORD=changeme

KAFKA_GATEWAY_USERNAME=gateway-service
KAFKA_GATEWAY_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Kafka topic names
# -----------------------------------------------------------------------------
KAFKA_TOPIC_GPS_PINGS=gps-pings
KAFKA_TOPIC_RIDE_EVENTS=ride-events
KAFKA_TOPIC_DISPATCH_COMMANDS=dispatch-commands
KAFKA_TOPIC_NOTIFICATIONS=notifications

# -----------------------------------------------------------------------------
# Ingest Service (Go) — host port 8001
# SERVICE_PORT is read by the service at startup; no hardcoded defaults.
# -----------------------------------------------------------------------------
INGEST_SERVICE_PORT=8001
INGEST_MAX_REQUEST_BODY_BYTES=65536

# -----------------------------------------------------------------------------
# Dispatch Service (Spring Boot / Java 21) — host port 8080
# SPRING_DATASOURCE_* are standard Spring Boot datasource properties.
# PgBouncer sits between the service and PostgreSQL (transaction pooling mode).
# -----------------------------------------------------------------------------
DISPATCH_SERVICE_PORT=8080
DISPATCH_MAX_REQUEST_BODY_BYTES=65536
SPRING_DATASOURCE_URL=jdbc:postgresql://pgbouncer:5432/dispatch_db
SPRING_DATASOURCE_USERNAME=dispatch_user
SPRING_DATASOURCE_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Notification Service (Go) — host port 8002
# -----------------------------------------------------------------------------
NOTIFICATION_SERVICE_PORT=8002
NOTIFICATION_KAFKA_CONSUMER_GROUP=notification-service-group

# -----------------------------------------------------------------------------
# Gateway Service (Go — WebSocket hub) — host port 8003
# -----------------------------------------------------------------------------
GATEWAY_SERVICE_PORT=8003
GATEWAY_KAFKA_CONSUMER_GROUP=gateway-consumer-group

# -----------------------------------------------------------------------------
# Tracking Service (Go — geospatial state, ETA computation) — host port 8004
# -----------------------------------------------------------------------------
TRACKING_SERVICE_PORT=8004
TRACKING_KAFKA_CONSUMER_GROUP=tracking-consumer-group

# -----------------------------------------------------------------------------
# Redis (password-protected; used for geospatial driver index and ETA cache)
# REDIS_URL is the full connection URL read by Go services.
# -----------------------------------------------------------------------------
REDIS_URL=redis://:changeme@redis:6379/0
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# OpenTelemetry — all services export traces via OTLP to Jaeger
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# -----------------------------------------------------------------------------
# Driver Simulator (used when running outside docker-compose)
# -----------------------------------------------------------------------------
INGEST_URL=http://localhost:8001
