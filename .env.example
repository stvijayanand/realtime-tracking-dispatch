# =============================================================================
# Real-Time Tracking & Dispatch Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running docker-compose.
# NEVER commit .env to source control — it is gitignored.
# All values below are placeholders. Replace "changeme" with strong passwords.
# See docs/adr/004-security-model.md for the full secrets management strategy.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=dispatch_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dispatch_db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Redpanda (Kafka-compatible broker)
# Admin superuser — used only by the Redpanda init container for topic creation.
# NOT shared with application services.
# -----------------------------------------------------------------------------
REDPANDA_SUPERUSER_USERNAME=admin
REDPANDA_SUPERUSER_PASSWORD=changeme
REDPANDA_BROKER_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDPANDA_SCHEMA_REGISTRY_PORT=8081

# -----------------------------------------------------------------------------
# Kafka SASL credentials — one set per service (principle of least privilege)
# Each service can only produce/consume the topics it owns (see ADR 004).
# -----------------------------------------------------------------------------
KAFKA_INGEST_USERNAME=ingest-service
KAFKA_INGEST_PASSWORD=changeme

KAFKA_DISPATCH_USERNAME=dispatch-service
KAFKA_DISPATCH_PASSWORD=changeme

KAFKA_NOTIFICATION_USERNAME=notification-service
KAFKA_NOTIFICATION_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Kafka topic names
# -----------------------------------------------------------------------------
KAFKA_TOPIC_GPS_PINGS=gps-pings
KAFKA_TOPIC_RIDE_EVENTS=ride-events
KAFKA_TOPIC_DISPATCH_COMMANDS=dispatch-commands
KAFKA_TOPIC_NOTIFICATIONS=notifications

# -----------------------------------------------------------------------------
# Ingest Service (FastAPI)
# -----------------------------------------------------------------------------
INGEST_PORT=8001
INGEST_MAX_REQUEST_BODY_BYTES=65536

# -----------------------------------------------------------------------------
# Dispatch Service (Spring Boot)
# -----------------------------------------------------------------------------
DISPATCH_PORT=8080
DISPATCH_MAX_REQUEST_BODY_BYTES=65536

# -----------------------------------------------------------------------------
# Notification Service (FastAPI)
# -----------------------------------------------------------------------------
NOTIFICATION_PORT=8002
NOTIFICATION_KAFKA_CONSUMER_GROUP=notification-service-group

# -----------------------------------------------------------------------------
# Driver Simulator (used when running outside docker-compose)
# -----------------------------------------------------------------------------
INGEST_URL=http://localhost:8001
