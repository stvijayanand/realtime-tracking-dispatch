{
  "type": "record",
  "namespace": "com.dispatch.events",
  "name": "TripRequested",
  "doc": "Domain Event published when the Dispatch Service receives a ride request from a rider. Published to the ride-events Kafka topic. Triggers the driver assignment saga.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID v4 uniquely identifying this event instance. Generated by the producer at publish time. Used as the deduplication key for consumer-side idempotency."
    },
    {
      "name": "event_type",
      "type": "string",
      "default": "TripRequested",
      "doc": "Discriminator field identifying the Domain Event type. Always 'TripRequested' for this schema. Part of the schema contract — not a Kafka header."
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 UTC timestamp recording when this event occurred (e.g. '2024-01-15T10:30:00.000Z'). Set by the producer at publish time."
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "TripRequestedPayload",
        "doc": "Domain-specific payload for the TripRequested event.",
        "fields": [
          {
            "name": "trip_id",
            "type": "string",
            "doc": "UUID v4 uniquely identifying the Trip aggregate instance. Generated by the Dispatch Service at request time. Stable across all subsequent events in the trip lifecycle."
          },
          {
            "name": "rider_id",
            "type": "string",
            "doc": "Identifier of the rider who requested the trip. Non-empty string, maximum 128 characters."
          },
          {
            "name": "pickup_location",
            "type": {
              "type": "record",
              "name": "PickupLocation",
              "doc": "WGS-84 geographic coordinate representing the rider's requested pickup point.",
              "fields": [
                {
                  "name": "latitude",
                  "type": "double",
                  "doc": "WGS-84 latitude of the pickup location. Valid range: -90.0 to 90.0 (inclusive)."
                },
                {
                  "name": "longitude",
                  "type": "double",
                  "doc": "WGS-84 longitude of the pickup location. Valid range: -180.0 to 180.0 (inclusive)."
                }
              ]
            },
            "doc": "Geographic coordinate of the rider's requested pickup point."
          },
          {
            "name": "requested_at",
            "type": "string",
            "doc": "ISO 8601 UTC timestamp recording when the ride was requested (e.g. '2024-01-15T10:30:00.000Z'). Set by the Dispatch Service when the HTTP request is processed."
          }
        ]
      },
      "doc": "Domain-specific payload containing the trip request data."
    }
  ]
}
