{
  "type": "record",
  "namespace": "com.dispatch.events",
  "name": "TripAssigned",
  "doc": "Domain Event published when the Dispatch Service assigns a driver to a trip. Published to the ride-events Kafka topic. Consumed by the Notification Service (push log) and Gateway Service (WebSocket push to rider).",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID v4 uniquely identifying this event instance. Generated by the producer at publish time. Used as the deduplication key for consumer-side idempotency."
    },
    {
      "name": "event_type",
      "type": "string",
      "default": "TripAssigned",
      "doc": "Discriminator field identifying the Domain Event type. Always 'TripAssigned' for this schema. Part of the schema contract — not a Kafka header."
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 UTC timestamp recording when this event occurred (e.g. '2024-01-15T10:30:00.000Z'). Set by the producer at publish time."
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "TripAssignedPayload",
        "doc": "Domain-specific payload for the TripAssigned event.",
        "fields": [
          {
            "name": "trip_id",
            "type": "string",
            "doc": "UUID v4 identifying the Trip aggregate. Matches the trip_id from the corresponding TripRequested event."
          },
          {
            "name": "driver_id",
            "type": "string",
            "doc": "Identifier of the driver assigned to this trip. Selected by the Dispatch Service driver selection strategy. Non-empty string."
          },
          {
            "name": "rider_id",
            "type": "string",
            "doc": "Identifier of the rider who requested the trip. Carried forward from the TripRequested event. Non-empty string, maximum 128 characters."
          },
          {
            "name": "assigned_at",
            "type": "string",
            "doc": "ISO 8601 UTC timestamp recording when the driver was assigned to the trip (e.g. '2024-01-15T10:30:01.500Z'). Set by the Dispatch Service when the assignment is persisted."
          }
        ]
      },
      "doc": "Domain-specific payload containing the driver assignment data."
    }
  ]
}
