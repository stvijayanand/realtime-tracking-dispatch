{
  "type": "record",
  "namespace": "com.dispatch.events",
  "name": "LocationPingReceived",
  "doc": "Domain Event published when the Ingest Service receives a valid GPS ping from a driver. Published to the gps-pings Kafka topic.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID v4 uniquely identifying this event instance. Generated by the producer at publish time. Used as the deduplication key for consumer-side idempotency."
    },
    {
      "name": "event_type",
      "type": "string",
      "default": "LocationPingReceived",
      "doc": "Discriminator field identifying the Domain Event type. Always 'LocationPingReceived' for this schema. Part of the schema contract — not a Kafka header."
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 UTC timestamp recording when this event occurred (e.g. '2024-01-15T10:30:00.000Z'). Set by the producer at publish time."
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "LocationPingReceivedPayload",
        "doc": "Domain-specific payload for the LocationPingReceived event.",
        "fields": [
          {
            "name": "driver_id",
            "type": "string",
            "doc": "Identifier of the driver who emitted this GPS ping. Non-empty string, maximum 128 characters."
          },
          {
            "name": "latitude",
            "type": "double",
            "doc": "WGS-84 latitude of the driver's position. Valid range: -90.0 to 90.0 (inclusive)."
          },
          {
            "name": "longitude",
            "type": "double",
            "doc": "WGS-84 longitude of the driver's position. Valid range: -180.0 to 180.0 (inclusive)."
          },
          {
            "name": "timestamp",
            "type": "string",
            "doc": "ISO 8601 UTC timestamp from the driver's device recording when the GPS ping was captured (e.g. '2024-01-15T10:30:00.000Z'). May differ from occurred_at due to network latency."
          }
        ]
      },
      "doc": "Domain-specific payload containing the GPS ping data."
    }
  ]
}
