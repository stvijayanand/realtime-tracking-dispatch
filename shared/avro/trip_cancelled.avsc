{
  "type": "record",
  "namespace": "com.dispatch.events",
  "name": "TripCancelled",
  "doc": "Domain Event representing a trip cancellation. Modelled in Phase 1 as a first-class compensating event in the domain model; not triggered by any service in Phase 1. The Saga State Monitor (Phase 2) will emit this event for trips stuck in intermediate states beyond a timeout threshold.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID v4 uniquely identifying this event instance. Generated by the producer at publish time. Used as the deduplication key for consumer-side idempotency."
    },
    {
      "name": "event_type",
      "type": "string",
      "default": "TripCancelled",
      "doc": "Discriminator field identifying the Domain Event type. Always 'TripCancelled' for this schema. Part of the schema contract — not a Kafka header."
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 UTC timestamp recording when this event occurred (e.g. '2024-01-15T10:30:00.000Z'). Set by the producer at publish time."
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "TripCancelledPayload",
        "doc": "Domain-specific payload for the TripCancelled event.",
        "fields": [
          {
            "name": "trip_id",
            "type": "string",
            "doc": "UUID v4 identifying the Trip aggregate being cancelled. Matches the trip_id from the corresponding TripRequested event."
          },
          {
            "name": "reason",
            "type": "string",
            "doc": "Human-readable description of why the trip was cancelled (e.g. 'No driver available', 'Rider cancelled', 'Trip expired'). Non-empty string."
          },
          {
            "name": "cancelled_at",
            "type": "string",
            "doc": "ISO 8601 UTC timestamp recording when the trip was cancelled (e.g. '2024-01-15T10:35:00.000Z'). Set by the Dispatch Service when the cancellation is persisted."
          }
        ]
      },
      "doc": "Domain-specific payload containing the trip cancellation data."
    }
  ]
}
